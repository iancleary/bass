# Copy this file to the bass configuration path.
# Remove group and other access before writing a real token.
# Each assignment is one KEY=value line. The value is literal text.
# BASS_TOKEN_ORIGIN is a scheme, host, and optional port. It has no path.

BASS_ENDPOINT=https://gateway.example/v1
BASS_TOKEN=replace-with-the-token
BASS_TOKEN_ORIGIN=https://gateway.example
